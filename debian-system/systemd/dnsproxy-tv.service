[Unit]
Description=AdGuard dnsproxy IPv4-only filter for Hisense TV (AAAA disabled)
After=network-online.target pihole-FTL.service
Wants=pihole-FTL.service

[Service]
Type=simple
ExecStart=/usr/local/bin/dnsproxy -l 127.0.0.1 -l 192.168.1.118 -p 5354 -u 127.0.0.1:53 --ipv6-disabled
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
